/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' https://static.cloudflareinsights.com; connect-src 'self' https://gestion.dreamzz.fr https://cloudflareinsights.com; form-action 'self' https://gestion.dreamzz.fr; frame-ancestors 'self'; base-uri 'self'
/css/*
  Cache-Control: public, max-age=604800
/js/*
  Cache-Control: public, max-age=86400
/img/*
  Cache-Control: public, max-age=2592000
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
